<?xml version="1.0"?>
<package format="3">
  <name>fr3_bolt_inspection_cell</name><version>0.1.0</version>
  <description>Point-cloud bolt picking, object-centred inspection and dual FR3 handover.</description>
  <maintainer email="maintainer@example.com">FR3 cell maintainer</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>
  <depend>gazebo_ros</depend><depend>rclcpp</depend><depend>std_srvs</depend>
  <depend>gazebo_dev</depend>
  <exec_depend>fr3_dual_bolt_cell</exec_depend><exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs_py</exec_depend><depend>sensor_msgs</depend>
  <exec_depend>std_msgs</exec_depend><exec_depend>geometry_msgs</exec_depend>
  <exec_depend>moveit_msgs</exec_depend><exec_depend>shape_msgs</exec_depend>
  <exec_depend>control_msgs</exec_depend><exec_depend>trajectory_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend><exec_depend>gazebo_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend><exec_depend>python3-scipy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-tk</exec_depend><exec_depend>action_msgs</exec_depend>
  <exec_depend>builtin_interfaces</exec_depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <export><build_type>ament_cmake</build_type><gazebo_ros plugin_path="${prefix}/../../lib"/></export>
</package>
