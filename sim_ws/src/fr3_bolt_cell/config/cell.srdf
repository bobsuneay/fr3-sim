<?xml version="1.0"?>
<robot name="fairino3_v6_robot">
  <group name="fairino3_v6_group"><chain base_link="base_link" tip_link="gripper_tcp"/></group>
  <group name="gripper">
    <joint name="left_finger_joint"/><joint name="right_finger_joint"/>
  </group>
  <end_effector name="parallel_gripper" parent_link="gripper_palm"
                group="gripper" parent_group="fairino3_v6_group"/>
  <group_state name="ready" group="fairino3_v6_group">
    <joint name="j1" value="1.57079632679"/><joint name="j2" value="-1.2"/>
    <joint name="j3" value="1.8"/><joint name="j4" value="-0.6"/>
    <joint name="j5" value="-1.57079632679"/><joint name="j6" value="0"/>
  </group_state>
  <group_state name="open" group="gripper">
    <joint name="left_finger_joint" value="0.025"/><joint name="right_finger_joint" value="0.025"/>
  </group_state>
  <group_state name="closed" group="gripper">
    <!-- Keep a 0.5 mm empty gap so contact-tolerant collision checks do not reject the goal. -->
    <joint name="left_finger_joint" value="0.00025"/><joint name="right_finger_joint" value="0.00025"/>
  </group_state>
  <!-- Only mounting/adjacent contact exclusions, not an all-pairs disable. -->
  <disable_collisions link1="support_link" link2="support_foot" reason="Adjacent"/>
  <disable_collisions link1="support_link" link2="side_mount_plate" reason="Adjacent"/>
  <disable_collisions link1="side_mount_plate" link2="base_link" reason="Adjacent"/>
  <disable_collisions link1="support_link" link2="base_link" reason="Adjacent"/>
  <disable_collisions link1="support_link" link2="head_camera_link" reason="Adjacent"/>
  <disable_collisions link1="support_link" link2="head_bracket" reason="Adjacent"/>
  <disable_collisions link1="head_bracket" link2="head_camera_link" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="shoulder_link" reason="Adjacent"/>
  <disable_collisions link1="shoulder_link" link2="upperarm_link" reason="Adjacent"/>
  <disable_collisions link1="upperarm_link" link2="forearm_link" reason="Adjacent"/>
  <disable_collisions link1="forearm_link" link2="wrist1_link" reason="Adjacent"/>
  <disable_collisions link1="wrist1_link" link2="wrist2_link" reason="Adjacent"/>
  <disable_collisions link1="wrist2_link" link2="wrist3_link" reason="Adjacent"/>
  <disable_collisions link1="wrist3_link" link2="gripper_palm" reason="Adjacent"/>
  <disable_collisions link1="gripper_palm" link2="left_finger" reason="Adjacent"/>
  <disable_collisions link1="gripper_palm" link2="right_finger" reason="Adjacent"/>
</robot>
