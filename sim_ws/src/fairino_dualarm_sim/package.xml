<?xml version="1.0"?>
<package format="3">
  <name>fairino_dualarm_sim</name>
  <version>0.1.0</version>
  <description>Self-contained ROS 2 dual-arm simulation MVP for Sim2Real.</description>
  <maintainer email="user@example.com">fairino_dualarm</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
