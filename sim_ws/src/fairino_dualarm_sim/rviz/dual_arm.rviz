Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 1
      Class: rviz_default_plugins/Grid
      Name: Grid
      Plane: XY
      Plane Cell Count: 20
      Cell Size: 0.1
      Line Style: Lines
      Color: 160; 160; 160
      Reference Frame: world
      Value: true
    - Alpha: 1
      Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Description Source: Topic
      Description Topic: /robot_description
      TF Prefix: ""
      Visual Enabled: true
      Collision Enabled: true
      Update Interval: 0
      Value: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Frame Timeout: 15
      Marker Scale: 0.15
      Show Arrows: true
      Show Axes: true
      Show Names: false
      Value: true
    - Class: rviz_default_plugins/Marker
      Name: Vision Object
      Marker Topic: /vision/object_marker
      Namespaces:
        sim_vision: true
      Queue Size: 100
      Value: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: world
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 2.5
      Focal Point: 0; 0; 0.9
      Pitch: 0.45
      Yaw: 0.75
Window Geometry:
  Height: 900
  Width: 1400
